---
import Layout from "../layouts/Layout.astro";
import { Chessboard3D } from "../components/Chessboard3D";
import TypingHeroTitle from "../components/TypingHeroTitle.astro";

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{
			"@type": "Question",
			name: "Can I play chess online for free?",
			acceptedAnswer: {
				"@type": "Answer",
				text: "Yes. You can start and play chess online for free on chesson.me.",
			},
		},
		{
			"@type": "Question",
			name: "Do I need registration to start?",
			acceptedAnswer: {
				"@type": "Answer",
				text: "No. You can start a game without mandatory registration.",
			},
		},
		{
			"@type": "Question",
			name: "Can I play against a bot?",
			acceptedAnswer: {
				"@type": "Answer",
				text: "Yes. You can play online chess with a computer and choose a suitable difficulty level.",
			},
		},
		{
			"@type": "Question",
			name: "Does it work on mobile and desktop?",
			acceptedAnswer: {
				"@type": "Answer",
				text: "Yes. chesson.me works in modern mobile and desktop browsers.",
			},
		},
	],
};
---

<Layout 
	lang="en" 
	title="Play Chess Online for Free — chesson.me"
	description="Play chess online without registration. Random opponents, games vs bot, and AI-powered hints."
	canonicalUrl="https://chesson.me/"
	ogImage="https://chesson.me/og.png"
	locale="en_US"
	alternates={[
		{ lang: "en", url: "https://chesson.me/" },
		{ lang: "ru", url: "https://chesson.me/ru/" },
		{ lang: "x-default", url: "https://chesson.me/" },
	]}
>
	<main class="bg-[#070707] text-white">
		<section class="relative w-full h-screen overflow-hidden">
			<header class="absolute top-0 left-0 right-0 z-10 p-9">
				<nav class="flex justify-between items-center max-w-6xl mx-auto">
					<div class="flex items-center">
						<img src="/chesson-logo.svg" alt="Chesson Logo" />
					</div>
				</nav>
			</header>
			<div
				class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 z-10 text-center w-[calc(100%-2rem)] max-w-4xl flex flex-col justify-center items-center h-full"
			>
				<TypingHeroTitle
					phrases={[
						"Play chess online for free without registration",
						"Solve chess puzzles online for free",
						"Run Swiss-system chess tournaments online",
					]}
					label="Play chess online for free without registration. Solve chess puzzles online for free. Run Swiss-system chess tournaments online."
				/>
				<h2 class="mb-10 font-normal text-3xl">
					Play free online chess in your browser with friends, opponents, or a bot without signup
				</h2>
				<div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 w-full sm:w-auto">
					<a
						id="create-room-btn"
						href="https://game.chesson.me/"
						class="w-full sm:w-auto bg-white text-black font-bold py-3 px-6 rounded-md hover:bg-gray-200 transition duration-300 text-lg cursor-pointer"
					>
						Play
					</a>
				</div>
			</div>
			<Chessboard3D client:idle />
			<div class="absolute left-0 bottom-[40px] right-0 z-[10]">
				<div class="text-center text-xm opacity-70 flex flex-col md:flex-row items-center justify-center gap-1 md:gap-[14px]">
					<a href="/release-notes/" class="hover:opacity-100 transition-opacity order-1 md:order-3">
						<span class="order-2 md:order-1">v2.1.0 + <span class="font-extrabold bg-gradient-to-r from-[#E810A7] to-[#FFE600] bg-clip-text text-transparent italic">Puzzles and Analysis</span></span>
					</a>
					<a href="https://t.me/chessonme" target="_blank" rel="noopener noreferrer" class="hover:opacity-100 transition-opacity order-2 md:order-4">Telegram</a>
				</div>
			</div>
		</section>

		<section class="mx-auto w-[calc(100%-2rem)] max-w-6xl py-16 sm:py-20">
			<div class="grid gap-5 min-[900px]:grid-cols-2">
				<a href="https://game.chesson.me/quick-play?timeMinutes=10&incrementSeconds=0" class="group relative min-h-[190px] overflow-hidden rounded-xl border border-[#6D5DF6]/70 bg-[#140F35] p-8 text-left transition hover:border-[#8B7CFF] hover:bg-[#181043] active:scale-[0.995]">
					<div class="absolute inset-0 opacity-35 [background:linear-gradient(90deg,rgba(79,57,246,0.4),rgba(8,10,18,0.2)),linear-gradient(135deg,transparent_0%,transparent_62%,rgba(255,255,255,0.06)_62%,rgba(255,255,255,0.06)_100%)]"></div>
					<div class="relative flex h-full flex-col items-start justify-between gap-6">
						<div class="flex flex-col gap-5">
							<div class="flex h-16 w-16 shrink-0 aspect-square items-center justify-center rounded-full border border-[#8B7CFF]/50 bg-[#4F39F6]/25 text-[#C9C2FF]">
								<svg class="h-9 w-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.4 2.1 4.7 13.4c-.3.4 0 1 .5 1h5.4l-1.2 7.2c-.1.7.8 1 1.2.5l8.7-11.3c.3-.4 0-1-.5-1h-5.4l1.2-7.2c.1-.7-.8-1-1.2-.5Z" /></svg>
							</div>
							<div>
								<h2 class="text-3xl font-bold leading-tight text-white min-[1180px]:text-4xl">Quick play</h2>
								<p class="mt-3 text-lg text-white/75">Play free online chess with a random opponent.</p>
								<div class="mt-6 flex flex-wrap gap-3">
									<span class="rounded-lg bg-white/[0.08] px-4 py-2 text-sm font-semibold text-white/85">10 min + 0 sec</span>
								</div>
							</div>
						</div>
					</div>
				</a>

				<a href="https://game.chesson.me/puzzles" class="group relative min-h-[190px] overflow-hidden rounded-xl border border-rose-500/40 bg-rose-950/20 p-8 text-left transition hover:border-rose-400/70 hover:bg-[#35102d] active:scale-[0.995]">
					<div class="absolute inset-0 opacity-35 [background:linear-gradient(90deg,rgba(190,24,93,0.45),rgba(79,57,246,0.18)),linear-gradient(135deg,transparent_0%,transparent_62%,rgba(255,255,255,0.06)_62%,rgba(255,255,255,0.06)_100%)]"></div>
					<div class="relative flex h-full flex-col items-start justify-between gap-6">
						<div class="flex flex-col gap-5">
							<div class="flex h-16 w-16 shrink-0 aspect-square items-center justify-center rounded-full border border-rose-400/40 bg-rose-500/[0.18] text-rose-200">
								<svg class="h-9 w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959a.64.64 0 0 1-.657.643 48.39 48.39 0 0 1-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 0 1-.658.663c-.355 0-.676-.186-.959-.401a1.647 1.647 0 0 0-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401.31 0 .555.26.532.57a48.039 48.039 0 0 1-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 0 0 .657-.643c0-.355-.186-.676-.401-.959a1.647 1.647 0 0 1-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959 0 .333.277.599.61.58a48.1 48.1 0 0 0 5.427-.63 48.05 48.05 0 0 0 .582-4.717.532.532 0 0 0-.533-.57c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.96.401a.656.656 0 0 0 .658-.663 48.422 48.422 0 0 0-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 0 1-.61-.58Z" /></svg>
							</div>
							<div>
								<h2 class="text-3xl font-bold leading-tight text-white min-[1180px]:text-4xl">Chess puzzles</h2>
								<p class="mt-3 text-lg text-white/75">Solve tactics from real games with hints and move history.</p>
								<div class="mt-6 flex flex-wrap gap-3">
									<span class="rounded-lg bg-rose-500/[0.14] px-4 py-2 text-sm font-semibold text-rose-100">Puzzles</span>
									<span class="rounded-lg bg-rose-500/[0.14] px-4 py-2 text-sm font-semibold text-rose-100">Hints</span>
								</div>
							</div>
						</div>
					</div>
				</a>
			</div>

			<div class="mt-5 grid gap-5 min-[900px]:grid-cols-2 min-[1180px]:grid-cols-3">
				<a href="https://chesson.me/tournaments/" class="group relative min-h-[190px] overflow-hidden rounded-xl border border-sky-500/40 bg-sky-950/20 p-8 text-left transition hover:border-sky-400/70 hover:bg-sky-950/30 active:scale-[0.995]">
					<div class="absolute inset-0 opacity-35 [background:linear-gradient(90deg,rgba(14,165,233,0.34),rgba(8,10,18,0.18)),linear-gradient(135deg,transparent_0%,transparent_62%,rgba(255,255,255,0.06)_62%,rgba(255,255,255,0.06)_100%)]"></div>
					<div class="relative flex h-full flex-col items-start justify-between gap-6">
						<div class="flex flex-col gap-5">
							<div class="flex h-16 w-16 shrink-0 aspect-square items-center justify-center rounded-full border border-sky-400/35 bg-sky-500/15 text-sky-300">
								<svg class="h-9 w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h10" /></svg>
							</div>
							<div>
								<h2 class="text-3xl font-bold leading-tight text-white min-[1180px]:text-4xl">Tournament bracket</h2>
								<p class="mt-3 text-lg text-white/75">Create a chess tournament bracket for offline games and events.</p>
								<div class="mt-6 flex flex-wrap gap-3">
									<span class="rounded-lg bg-sky-500/[0.12] px-4 py-2 text-sm font-semibold text-sky-100">Bracket</span>
								</div>
							</div>
						</div>
					</div>
				</a>

				<a href="https://game.chesson.me/tournaments/new" class="group relative min-h-[190px] overflow-hidden rounded-xl border border-yellow-500/40 bg-yellow-950/20 p-8 text-left transition hover:border-yellow-400/70 hover:bg-yellow-950/30 active:scale-[0.995]">
					<div class="absolute inset-0 opacity-35 [background:linear-gradient(90deg,rgba(234,179,8,0.34),rgba(8,10,18,0.18)),linear-gradient(135deg,transparent_0%,transparent_62%,rgba(255,255,255,0.06)_62%,rgba(255,255,255,0.06)_100%)]"></div>
					<div class="relative flex h-full flex-col items-start justify-between gap-6">
						<div class="flex flex-col gap-5">
							<div class="flex h-16 w-16 shrink-0 aspect-square items-center justify-center rounded-full border border-yellow-400/35 bg-yellow-500/15 text-yellow-300">
								<svg class="h-9 w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 21h8" /><path d="M12 17v4" /><path d="M7 4h10v4a5 5 0 0 1-10 0V4Z" /><path d="M5 5H3v2a4 4 0 0 0 4 4" /><path d="M19 5h2v2a4 4 0 0 1-4 4" /></svg>
							</div>
							<div>
								<h2 class="text-3xl font-bold leading-tight text-white min-[1180px]:text-4xl">Create online tournament</h2>
								<p class="mt-3 text-lg text-white/75">Run a Swiss-system chess tournament with automatic pairings.</p>
								<div class="mt-6 flex flex-wrap gap-3">
									<span class="rounded-lg bg-yellow-500/[0.12] px-4 py-2 text-sm font-semibold text-yellow-100">Swiss system</span>
								</div>
							</div>
						</div>
					</div>
				</a>

				<button id="labs-open-btn" type="button" class="labs-featured-card order-first group relative min-h-[190px] overflow-hidden rounded-xl border border-[#6D5DF6]/50 bg-[#130F2B] p-8 text-left transition hover:border-[#8B7CFF]/80 active:scale-[0.995]">
					<div class="absolute inset-0 opacity-35 [background:linear-gradient(90deg,rgba(79,57,246,0.36),rgba(8,10,18,0.18)),linear-gradient(135deg,transparent_0%,transparent_62%,rgba(255,255,255,0.06)_62%,rgba(255,255,255,0.06)_100%)]"></div>
					<span class="labs-new-badge absolute right-4 top-4 rounded-full border border-fuchsia-300/50 bg-fuchsia-500 px-3 py-1 text-xs font-black uppercase tracking-[0.12em] text-white shadow-[0_0_24px_rgba(217,70,239,0.65)]">New</span>
					<div class="relative flex h-full flex-col items-start justify-between gap-6">
						<div class="flex flex-col gap-5">
							<div class="flex h-16 w-16 shrink-0 aspect-square items-center justify-center rounded-full border border-[#8B7CFF]/50 bg-[#4F39F6]/25 text-[#C9C2FF]">
								<svg class="h-9 w-9" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M10 3h4M10.5 3v5.3L5.8 17a2.6 2.6 0 0 0 2.3 3.8h7.8a2.6 2.6 0 0 0 2.3-3.8l-4.7-8.7V3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /><path d="M8.2 15.2h7.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
							</div>
							<div>
								<h2 class="text-3xl font-bold leading-tight text-white min-[1180px]:text-4xl">Labs</h2>
								<p class="mt-3 text-lg text-white/75">Experimental games live here. Try a no-kings game now.</p>
								<div class="mt-6 flex flex-wrap gap-3">
									<span class="rounded-lg bg-white/[0.08] px-4 py-2 text-sm font-semibold text-white/85">Experimental</span>
									<span class="rounded-lg bg-white/[0.08] px-4 py-2 text-sm font-semibold text-white/85">No kings</span>
								</div>
							</div>
						</div>
					</div>
				</button>
			</div>
		</section>

		<div id="labs-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 px-4">
			<div class="w-full max-w-[520px] rounded-xl border border-[#8B7CFF]/30 bg-[#0B0B12] p-6 text-white shadow-2xl">
				<div class="flex items-start justify-between gap-4">
					<div>
						<h2 class="text-2xl font-bold">Labs</h2>
						<p class="mt-2 text-sm text-white/60">Choose an experimental mode. This is a game with a friend: create a room and send the link.</p>
					</div>
					<button id="labs-close-btn" type="button" class="rounded-lg px-3 py-2 text-white/60 transition hover:bg-white/10 hover:text-white">Close</button>
				</div>
				<div class="mt-6 grid gap-3">
					<button id="labs-two-queens-btn" type="button" class="group flex items-center justify-between gap-4 rounded-lg border border-[#8B7CFF]/45 bg-[#4F39F6]/15 p-4 text-left transition hover:border-[#B8AEFF] hover:bg-[#4F39F6]/25">
						<span>
							<span class="block text-lg font-semibold">2 Queens</span>
							<span class="mt-1 block text-sm text-white/60">A no-kings game. Capture every opponent piece. Create a room and send the link to a friend.</span>
						</span>
						<span class="text-2xl text-white/70">›</span>
					</button>
					<p class="rounded-lg border border-white/10 bg-white/[0.03] p-4 text-sm text-white/55">
						More experimental modes are coming soon.
					</p>
				</div>
			</div>
		</div>

		<script is:inline>
			const labsOpenBtn = document.getElementById("labs-open-btn");
			const labsCloseBtn = document.getElementById("labs-close-btn");
			const labsModal = document.getElementById("labs-modal");
			const twoQueensBtn = document.getElementById("labs-two-queens-btn");
			const twoQueensFen = "rnbqqbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQQBNR w - - 0 1";

			labsOpenBtn?.addEventListener("click", () => {
				labsModal?.classList.remove("hidden");
				labsModal?.classList.add("flex");
			});

			labsCloseBtn?.addEventListener("click", () => {
				labsModal?.classList.add("hidden");
				labsModal?.classList.remove("flex");
			});

			twoQueensBtn?.addEventListener("click", async () => {
				twoQueensBtn.disabled = true;
				const response = await fetch("https://game.chesson.me/api/rooms", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						whiteTimer: 600,
						blackTimer: 600,
						increment: 0,
						withAIhints: false,
						currentFEN: twoQueensFen,
						gameMode: "twoQueens",
					}),
				});
				const data = await response.json();
				if (data?.roomId) {
					window.location.href = `https://game.chesson.me/game/${data.roomId}`;
				} else {
					twoQueensBtn.disabled = false;
				}
			});
		</script>

		<style is:inline>
			@keyframes labsCardGlow {
				0%, 100% {
					box-shadow: 0 0 0 1px rgba(139, 124, 255, 0.18), 0 0 28px rgba(79, 57, 246, 0.18);
				}
				50% {
					box-shadow: 0 0 0 1px rgba(217, 70, 239, 0.42), 0 0 42px rgba(217, 70, 239, 0.34);
				}
			}

			@keyframes labsBadgePulse {
				0%, 100% {
					transform: scale(1);
				}
				50% {
					transform: scale(1.06);
				}
			}

			.labs-featured-card {
				animation: labsCardGlow 2.8s ease-in-out infinite;
			}

			.labs-new-badge {
				/* animation: labsBadgePulse 1.9s ease-in-out infinite; */
				font-style: italic;
			}

			@media (prefers-reduced-motion: reduce) {
				.labs-featured-card,
				.labs-new-badge {
					animation: none;
				}
			}
		</style>

		<section class="mx-auto w-[calc(100%-2rem)] max-w-6xl pb-16 sm:pb-20" aria-labelledby="faq-title">
			<div class="rounded-2xl border border-[#252525] bg-[#0F0F0F] p-6 sm:p-8">
				<h2 id="faq-title" class="text-2xl sm:text-3xl font-semibold">FAQ</h2>
				<div class="mt-6 grid gap-3 md:grid-cols-2">
					<details class="rounded-xl border border-[#222] bg-[#121212] px-4 py-3">
						<summary class="cursor-pointer font-semibold">Can I play chess online for free?</summary>
						<p class="mt-2 text-white/80">Yes. You can start and play chess online for free on chesson.me.</p>
					</details>
					<details class="rounded-xl border border-[#222] bg-[#121212] px-4 py-3">
						<summary class="cursor-pointer font-semibold">Do I need registration to start?</summary>
						<p class="mt-2 text-white/80">No. You can start a game without mandatory registration.</p>
					</details>
					<details class="rounded-xl border border-[#222] bg-[#121212] px-4 py-3">
						<summary class="cursor-pointer font-semibold">Can I play against a bot?</summary>
						<p class="mt-2 text-white/80">Yes. You can play online chess with a computer and choose a suitable difficulty level.</p>
					</details>
					<details class="rounded-xl border border-[#222] bg-[#121212] px-4 py-3">
						<summary class="cursor-pointer font-semibold">Does it work on mobile and desktop?</summary>
						<p class="mt-2 text-white/80">Yes. chesson.me works in modern mobile and desktop browsers.</p>
					</details>
				</div>
			</div>
		</section>

		<section class="mx-auto w-[calc(100%-2rem)] max-w-6xl pb-16 sm:pb-20" aria-labelledby="seo-text-title">
			<div class="rounded-2xl border border-[#252525] bg-[#0F0F0F] p-6 sm:p-8 text-sm sm:text-base leading-relaxed text-white/85">
				<h2 id="seo-text-title" class="text-xl sm:text-2xl font-semibold text-white">Play Chess Online in Seconds</h2>
				<p class="mt-4">
					On chesson.me, you can <strong>play chess online</strong> right in your browser in just a few clicks. The platform is built for quick daily matches and longer evening games.
				</p>
				<p class="mt-4">
					If you are looking for <strong>online chess for free</strong>, you can jump straight into a game: create a room, find an opponent, or start a match versus a bot. It is a simple <strong>chess game without registration</strong> and no unnecessary setup.
				</p>
				<p class="mt-4">
					You can also play <strong>online chess with a computer</strong> to train tactics and practice at your own pace. The service works smoothly on both mobile and desktop, so you can play anywhere.
				</p>
			</div>
		</section>

		<footer class="border-t border-white/10" aria-label="Footer links">
			<div class="mx-auto w-[calc(100%-2rem)] max-w-6xl py-12 sm:py-14">
				<div class="grid gap-10 lg:grid-cols-6">
					<div class="lg:col-span-2">
						<div class="flex items-center gap-3">
							<img src="/chesson-logo.svg" alt="Chesson" class="h-8 w-auto" />
						</div>
						<p class="mt-4 max-w-sm text-sm text-white/65">
							Play chess online for free: random opponents, bot matches, and offline tournament tools.
						</p>
					</div>

					<div>
						<h3 class="text-sm font-semibold text-white/90">Play</h3>
						<div class="mt-4 space-y-2 text-sm text-white/70">
							<a href="/play-chess-online-free/" class="block hover:text-white">Play chess online for free</a>
							<a href="/play-chess-with-bot/" class="block hover:text-white">Play chess with a bot</a>
							<a href="/play-chess-with-friends-link/" class="block hover:text-white">Play chess with friends</a>
						</div>
					</div>

					<div>
						<h3 class="text-sm font-semibold text-white/90">Chess</h3>
						<div class="mt-4 space-y-2 text-sm text-white/70">
							<a href="/tournaments" class="block hover:text-white">Tournament bracket</a>
