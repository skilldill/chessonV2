---
import '../styles/global.css';
import { SITE_URL } from '../config.mjs';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
}
const { title, description, path = '/', noindex = false } = Astro.props;
const canonical = new URL(path, SITE_URL).href;
const image = new URL('/social-preview.jpg', SITE_URL).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${SITE_URL}/#website`, name: 'Шахматы онлайн', url: `${SITE_URL}/`, inLanguage: 'ru' },
    {
      '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical,
      name: title, description, inLanguage: 'ru', isPartOf: { '@id': `${SITE_URL}/#website` },
    },
  ],
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Шахматы онлайн" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Шахматы онлайн: играть с другом или с ботом" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="Шахматы онлайн: играть с другом или с ботом" />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
    <!-- Yandex.Metrika counter -->
    <script is:inline type="text/javascript">
      (function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
      })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=113658367', 'ym');

      ym(113658367, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
    </script>
    <!-- /Yandex.Metrika counter -->
  </head>
  <body class="bg-black font-sans text-white antialiased">
    <noscript><div><img src="https://mc.yandex.ru/watch/113658367" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <a class="skip-link" href="#content">К содержимому</a>
    <slot />
  </body>
</html>

<style>
  .skip-link { position: absolute; left: 16px; top: -100px; z-index: 10; padding: 12px; background: white; color: black; }
  .skip-link:focus { top: 16px; }
