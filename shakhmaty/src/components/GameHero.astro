---
import RotatingPiece from './RotatingPiece.astro';
import { createGameUrl } from '../config.mjs';

interface Props {
  heading?: string;
  description?: string;
  home?: boolean;
  buttons?: {
    text: string;
    apperance: string;
    mode: string;
  }[]
}
const {
  heading = 'онлайн',
  description = 'Просто шахматы онлайн без регистрации бесплатно',
  home = false,
  buttons = [
    { text: 'Играть с другом', apperance: 'primary', mode: 'friend' },
    { text: 'Играть с ботом', apperance: 'secondary', mode: 'bot' },
  ],
} = Astro.props;
---

<main id="content" class="flex min-h-svh items-center justify-center px-6 py-12">
  <section class="relative w-full max-w-3xl text-center" aria-labelledby="page-title">
    <h1 id="page-title" class:list={[
      'flex flex-col items-center justify-center gap-1 font-normal leading-[1.1] sm:flex-row sm:flex-wrap sm:gap-x-5',
      home ? 'text-5xl sm:text-7xl' : 'text-4xl sm:text-5xl',
    ]}>
      <em class="font-serif font-normal italic">Шахматы</em>{' '}
      <span class="min-w-0 max-w-full">{heading}</span>
    </h1>
    <p class:list={['mx-auto mt-6 text-base leading-relaxed text-white/60', home ? 'max-w-sm sm:max-w-none' : 'max-w-lg']}>
      {description}
    </p>
    <div class="mx-auto mt-9 flex max-w-sm flex-col gap-3 sm:max-w-none sm:flex-row sm:justify-center">
      {buttons.map(({ mode, text, apperance }) => (
        <a href={createGameUrl(mode)} rel="nofollow" data-game-link class:list={[
          'inline-flex min-h-13 items-center justify-center rounded-md border px-7 py-3 text-base font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white motion-reduce:transition-none',
          apperance === 'primary'
            ? 'border-white bg-white text-black hover:border-neutral-200 hover:bg-neutral-200'
            : 'border-white/30 bg-transparent text-white hover:border-white hover:bg-white/5',
        ]}>{text}</a>
      ))}
    </div>
    <RotatingPiece piece="king" />
    <RotatingPiece piece="queen" />
  </section>
</main>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-game-link]')) {
    link.addEventListener('click', () => {
      const url = new URL(link.href);
      if (typeof crypto.randomUUID === 'function') url.searchParams.set('requestId', crypto.randomUUID());
      link.href = url.href;
      try {
        const metrika = (window as Window & { ym?: (...args: unknown[]) => void }).ym;
        metrika?.(113658367, 'reachGoal', 'play_click', {
          app: 'shakhmaty', placement: 'landing', mode: url.searchParams.get('mode'), landing_path: location.pathname,
        });
      } catch { /* Analytics must not interrupt navigation. */ }
    });
  }
</script>

<style>
  main { overflow: clip; }
  @media (max-width: 1279px) {
    main { padding-top: 204px; padding-bottom: 204px; }
  }
  @media (min-width: 640px) and (max-width: 1279px) and (max-height: 700px) {
    main { padding-top: 172px; padding-bottom: 172px; }
  }
  @media (max-width: 639px) and (max-height: 700px) {
    main { padding-top: 96px; padding-bottom: 124px; }
  }
  @media (max-height: 500px) {
    main { padding-top: 76px; padding-bottom: 80px; }
  }
</style>
